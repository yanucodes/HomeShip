# HomeShip environment variables.
# Copy this file to a local env file and fill in real values.
# The real env file is gitignored — never commit secrets.

# ── Required ─────────────────────────────────────────────────────────────

# PostgreSQL connection URL. A bare "postgresql://" (as Render provides) is
# rewritten to "postgresql+psycopg://" automatically by config.py.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/homeship

# Secret used to sign JWT access tokens. Generate a long random value, e.g.
#   openssl rand -hex 32
# Keep it secret; changing it invalidates every existing token.
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Algorithm used to sign JWTs.
JWT_ALGORITHM=set-algorithm-here

# ── Optional (defaults shown; uncomment to override) ─────────────────────

# Separate database used by the pytest suite.
# TEST_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/homeship_test

# Minutes an access token stays valid.
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# Days a task's due date is pushed out per missed period.
# DEFAULT_POSTPONE_DAYS=3

# Supply deadline urgency windows (days). YELLOW must be >= RED.
# SUPPLY_DEADLINE_RED_DAYS=1
# SUPPLY_DEADLINE_YELLOW_DAYS=7

# Local hour (0-23) at which a ship's day rolls over for the hourly cron.
# DAILY_ROLLOVER_HOUR=3
